# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/imovies

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Brevo (Sendinblue) Transactional Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=your_verified_sender@domain.com
SENDER_NAME=iMovies

# Twilio SendGrid Configuration
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=tickets@yourdomain.com

# Nodemailer SMTP Configuration (Fallback)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# TMDB API
TMDB_API_KEY=your_tmdb_api_key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
